@prefix ex: <https://w3id.org/bondgraph/tests/conflict-effort-kind-clash#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/bondgraph/tests/conflict-effort-kind-clash> a owl:Ontology ;
    rdfs:label "Category error: one quality asserted to be both a force and an electric potential"@en ;
    owl:imports <https://w3id.org/bondgraph/bfo> .

ex:q a owl:NamedIndividual,
        <https://w3id.org/bondgraph/bfo#ElectricPotentialProperty>,
        <https://w3id.org/bondgraph/bfo#ForceProperty> .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ex:q ) .

