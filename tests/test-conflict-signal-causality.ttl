@prefix bg: <https://w3id.org/bondgraph/core#> .
@prefix ex: <https://w3id.org/bondgraph/tests/conflict-signal-causality#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/bondgraph/tests/conflict-signal-causality> a owl:Ontology ;
    rdfs:label "Malformed model: causality assigned to a signal port"@en ;
    owl:imports <https://w3id.org/bondgraph/core> .

ex:p_r a owl:NamedIndividual,
        bg:PowerPort ;
    bg:hasEffort ex:e_p_r ;
    bg:hasFlow ex:f_p_r ;
    bg:inEnergyDomain bg:electricalDomain ;
    bg:portIndex "0"^^xsd:nonNegativeInteger ;
    bg:portOf ex:MR1 .

ex:p_sig a owl:NamedIndividual,
        bg:InputSignalPort ;
    bg:hasCausality bg:effortOut ;
    bg:portOf ex:MR1 .

ex:R_param a owl:NamedIndividual,
        bg:Resistance .

ex:e_p_r a owl:NamedIndividual,
        bg:Voltage ;
    bg:conjugateTo ex:f_p_r ;
    bg:symbol "e_r"^^xsd:string .

ex:MR1 a owl:NamedIndividual,
        bg:ModulatedResistor ;
    bg:hasParameter ex:R_param .

ex:f_p_r a owl:NamedIndividual,
        bg:ElectricCurrent ;
    bg:symbol "f_r"^^xsd:string .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ex:MR1 ex:R_param ex:p_sig ex:p_r ex:e_p_r ex:f_p_r ) .

