@prefix bg: <https://w3id.org/bondgraph/core#> .
@prefix ex: <https://w3id.org/bondgraph/tests/ok-derivative-causality#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/bondgraph/tests/ok-derivative-causality> a owl:Ontology ;
    rdfs:label "Consistent: a model holding a C element in derivative causality"@en ;
    owl:imports <https://w3id.org/bondgraph/core> .

ex:m a owl:NamedIndividual,
        bg:BondGraph ;
    bg:hasElement ex:C1 .

ex:p_c a owl:NamedIndividual,
        bg:PowerPort ;
    bg:hasEffort ex:e_p_c ;
    bg:hasFlow ex:f_p_c ;
    bg:inEnergyDomain bg:electricalDomain ;
    bg:portIndex "0"^^xsd:nonNegativeInteger ;
    bg:portOf ex:C1 .

ex:C_param a owl:NamedIndividual,
        bg:Capacitance .

ex:e_p_c a owl:NamedIndividual,
        bg:Voltage ;
    bg:conjugateTo ex:f_p_c ;
    bg:symbol "e_c"^^xsd:string .

ex:q_c a owl:NamedIndividual,
        bg:ElectricCharge ;
    bg:integralOf ex:f_p_c .

ex:C1 a owl:NamedIndividual,
        bg:CapacitiveStorage ;
    bg:hasCausalForm bg:derivativeCausality ;
    bg:hasGeneralizedDisplacement ex:q_c ;
    bg:hasParameter ex:C_param .

ex:f_p_c a owl:NamedIndividual,
        bg:ElectricCurrent ;
    bg:symbol "f_c"^^xsd:string .

[] a owl:AllDifferent ;
    owl:distinctMembers ( ex:m ex:C1 ex:C_param ex:q_c ex:p_c ex:e_p_c ex:f_p_c ) .

